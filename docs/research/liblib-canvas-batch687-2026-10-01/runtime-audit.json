     "valueBackAt720": 112
    },
    "minLeg": {
     "overflowAt150": 208,
     "rawSubtractionWouldBe": 62,
     "valueActuallyRead": 88,
     "overflowByStillPositive": 26,
     "independentRecheck": "630 recorded 'the panel still overflows' below 176. Measured overflowBy at H=150 is exactly 26, and 150 < 176, so the store MIN genuinely cannot save it."
    }
   },
   "note": "the loss is not a side effect, it IS the clamp's arithmetic"
  },
  "the-loss-does-not-require-hitting-the-store-minimum": {
   "ok": true,
   "detail": {
    "valuesSeenInThatLeg": [
     182,
     112,
     112
    ],
    "neverTouchedTheMin": true,
    "stillLost": 70,
    "conclusion": "so stickiness is a property of the ONE-WAY rule, not of the store minimum. Any window below 270 permanently demotes the height, however briefly it was visited."
   },
   "note": "attributing the behaviour to the MIN would have been a plausible wrong explanation"
  },
